From: dnf-for-termux <dev@termux.dev>
Date: Wed, 29 Jul 2026 22:17:43 -0600
Subject: [PATCH 1/2] Adapt paths for Termux ($PREFIX)

Replace FHS hardcoded paths with Termux-compatible paths.
All paths are prefixed with @TERMUX_PREFIX@ which is set during build.

In Termux, there is no /etc, /var, or /usr outside of $PREFIX.
All system paths must be prefixed with @TERMUX_PREFIX@ (which is
substituted at build time by the termux-packages build system).

This patch replaces hardcoded FHS paths in:

  - ext/repo_rpmdb_bdb.h      (RPM BDB database paths)
  - ext/repo_rpmdb_librpm.h   (RPM librpm database paths)
  - ext/repo_products.c       (product database paths)
  - ext/repo_deb.c            (dpkg database path)
  - ext/repo_releasefile_products.c  (release file path)
  - tools/rpmdb2solv.c        (appdata directories)

The @TERMUX_PREFIX@ placeholder is replaced with the actual Termux
prefix (e.g. /data/data/com.termux/files/usr) during the build.

 ext/repo_deb.c                    |  2 +-
 ext/repo_products.c               |  8 ++++----
 ext/repo_releasefile_products.c   |  2 +-
 ext/repo_rpmdb_bdb.h              | 14 +++++++-------
 ext/repo_rpmdb_librpm.h           | 12 ++++++------
 tools/rpmdb2solv.c                |  4 ++--
 6 files changed, 21 insertions(+), 21 deletions(-)

--- a/ext/repo_rpmdb_bdb.h	2026-07-29 22:17:43.634243166 -0600
+++ b/ext/repo_rpmdb_bdb.h	2026-07-29 22:19:48.382243174 -0600
@@ -73,9 +73,9 @@
 static void
 detect_dbpath(struct rpmdbstate *state)
 {
-  state->dbpath = access_rootdir(state, "/var/lib/rpm", W_OK) == -1
-                  && access_rootdir(state, "/usr/share/rpm/Packages", R_OK) == 0
-                  ? "/usr/share/rpm" : "/var/lib/rpm";
+  state->dbpath = access_rootdir(state, "@TERMUX_PREFIX@/var/lib/rpm", W_OK) == -1
+                  && access_rootdir(state, "@TERMUX_PREFIX@/share/rpm/Packages", R_OK) == 0
+                  ? "@TERMUX_PREFIX@/share/rpm" : "@TERMUX_PREFIX@/var/lib/rpm";
 }
 
 static int
@@ -146,7 +146,7 @@
   int fd;
   struct flock fl;
 
-  lpath = solv_dupjoin(state->rootdir, "/var/lib/rpm/.dbenv.lock", 0);
+  lpath = solv_dupjoin(state->rootdir, "@TERMUX_PREFIX@/var/lib/rpm/.dbenv.lock", 0);
   oldmask = umask(022);
   fd = open(lpath, (O_RDWR|O_CREAT), 0644);
   free(lpath);
@@ -182,13 +182,13 @@
 #if (defined(FEDORA) || defined(MAGEIA)) && (DB_VERSION_MAJOR >= 5 || (DB_VERSION_MAJOR == 4 && DB_VERSION_MINOR >= 5))
   dbenv->set_thread_count(dbenv, 8);
 #endif
-  state->dbpath = "/var/lib/rpm";
+  state->dbpath = "@TERMUX_PREFIX@/var/lib/rpm";
   dbpath = solv_dupjoin(state->rootdir, state->dbpath, 0);
   if (access(dbpath, W_OK) == -1)
     {
-      if (access_rootdir(state, "/usr/share/rpm/Packages", R_OK) == 0)
+      if (access_rootdir(state, "@TERMUX_PREFIX@/share/rpm/Packages", R_OK) == 0)
 	{
-	  state->dbpath = "/usr/share/rpm";
+	  state->dbpath = "@TERMUX_PREFIX@/share/rpm";
 	  free(dbpath);
 	  dbpath = solv_dupjoin(state->rootdir, state->dbpath, 0);
 	}
--- a/ext/repo_rpmdb_librpm.h	2026-07-29 22:17:43.634243166 -0600
+++ b/ext/repo_rpmdb_librpm.h	2026-07-29 22:18:57.814243171 -0600
@@ -54,20 +54,20 @@
       return;
     }
   solv_free((char *)state->dbpath);
-  if (access_rootdir(state, "/var/lib/rpm", W_OK) == -1)
+  if (access_rootdir(state, "@TERMUX_PREFIX@/var/lib/rpm", W_OK) == -1)
     {
-      if (access_rootdir(state, "/usr/share/rpm/Packages", R_OK) == 0 || access_rootdir(state, "/usr/share/rpm/rpmdb.sqlite", R_OK) == 0)
+      if (access_rootdir(state, "@TERMUX_PREFIX@/share/rpm/Packages", R_OK) == 0 || access_rootdir(state, "@TERMUX_PREFIX@/share/rpm/rpmdb.sqlite", R_OK) == 0)
 	{
-	  state->dbpath = "/usr/share/rpm";
+	  state->dbpath = "@TERMUX_PREFIX@/share/rpm";
 	  return;
 	}
-      if (access_rootdir(state, "/usr/lib/sysimage/rpm/Packages.db", R_OK) == 0 || access_rootdir(state, "/usr/lib/sysimage/rpm/rpmdb.sqlite", R_OK) == 0 || access_rootdir(state, "/usr/lib/sysimage/rpm/Packages", R_OK) == 0)
+      if (access_rootdir(state, "@TERMUX_PREFIX@/lib/sysimage/rpm/Packages.db", R_OK) == 0 || access_rootdir(state, "@TERMUX_PREFIX@/lib/sysimage/rpm/rpmdb.sqlite", R_OK) == 0 || access_rootdir(state, "@TERMUX_PREFIX@/lib/sysimage/rpm/Packages", R_OK) == 0)
 	{
-	  state->dbpath = "/usr/lib/sysimage/rpm";
+	  state->dbpath = "@TERMUX_PREFIX@/lib/sysimage/rpm";
 	  return;
 	}
     }
-  state->dbpath = "/var/lib/rpm";
+  state->dbpath = "@TERMUX_PREFIX@/var/lib/rpm";
 }
 
 static int
