From: dnf-for-termux <dev@termux.dev>
Date: Fri, 31 Jul 2026 00:00:00 -0600
Subject: [PATCH 2/2] Use futimens() instead of futimes() for Android/bionic

futimes() is a GNU extension (glibc) and does not exist in Android's
bionic libc, so the shared library ends up with an undefined symbol
("contains undefined symbols: futimes").

Replace the single futimes() call in librepo/downloader.c with the
POSIX futimens() (available in bionic). The timeval {sec, usec}
pairs become timespec {sec, nsec} pairs; the microsecond values used
here are 0, so no numeric conversion is needed.

Also drop the now-unused _BSD_SOURCE define (deprecated in glibc
>= 2.19; its contents are covered by _DEFAULT_SOURCE) and keep
_DEFAULT_SOURCE, which is what exposes futimens() when building
against glibc with _XOPEN_SOURCE set to 500 (< 700).

futimens() is declared in <sys/stat.h>, already included.

diff --git a/librepo/downloader.c b/librepo/downloader.c
--- a/librepo/downloader.c
+++ b/librepo/downloader.c
@@ -19,8 +19,7 @@
  */
 
 #define _XOPEN_SOURCE   500 // Because of fdopen() and ftruncate()
-#define _DEFAULT_SOURCE     // Because of futimes()
-#define _BSD_SOURCE         // Because of futimes()
+#define _DEFAULT_SOURCE     // Because of futimens()
 
 #include <glib.h>
 #include <assert.h>
@@ -2283,8 +2282,8 @@
             long remote_filetime = -1;
             c_rc = curl_easy_getinfo(target->curl_handle, CURLINFO_FILETIME, &remote_filetime);
             if (c_rc == CURLE_OK && remote_filetime >= 0) {
-                const struct timeval tv[] = {{remote_filetime, 0}, {remote_filetime, 0}};
-                if (futimes(fd, tv) == -1)
+                const struct timespec ts[] = {{remote_filetime, 0}, {remote_filetime, 0}};
+                if (futimens(fd, ts) == -1)
                     g_debug("%s: Failed to change timestamps of downloaded file \"%s\"",
                             __func__, target->target->path);
             } else {
