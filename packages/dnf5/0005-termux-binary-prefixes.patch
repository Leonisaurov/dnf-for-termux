From: dnf-for-termux <dev@termux.dev>
Date: Wed, 29 Jul 2026 22:54:00 -0600
Subject: [PATCH 5/6] Adapt binary search prefixes for Termux ($PREFIX)

Replace the multi-path binary search prefixes (/bin/, /sbin/,
/usr/bin/, /usr/sbin/) with a single PREFIX_PATH("/bin/") since
Termux unifies all binaries under $PREFIX/bin/ with no /usr prefix
and no separate /sbin directory.

Affected files:
- dnf5/commands/provides/provides.cpp
- libdnf5-cli/output/provides.cpp
- libdnf5/rpm/package_query.cpp

diff --git a/dnf5/commands/provides/provides.cpp b/dnf5/commands/provides/provides.cpp
--- a/dnf5/commands/provides/provides.cpp
+++ b/dnf5/commands/provides/provides.cpp
@@ -84,12 +84,9 @@
         // if the spec is a binary name and there is no match from provide, try to prepend
         // /bin /sbin to match it by binary provides and continue
         else {
-            std::string bin_spec = "/bin/" + spec;
-            std::string sbin_spec = "/sbin/" + spec;
-            std::string usr_bin_spec = "/usr/bin/" + spec;
-            std::string usr_sbin_spec = "/usr/sbin/" + spec;
+            std::string bin_spec = PREFIX_PATH("/bin/") + spec;
             binary_query.filter_file(
-                std::vector<std::string>({bin_spec, sbin_spec, usr_bin_spec, usr_sbin_spec}),
+                std::vector<std::string>({bin_spec}),
                 libdnf5::sack::QueryCmp::GLOB);
             if (!binary_query.empty()) {
                 return std::make_pair(binary_query, libdnf5::cli::output::ProvidesMatchedBy::BINARY);
