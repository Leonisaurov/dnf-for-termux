From: dnf-for-termux <dev@termux.dev>
Date: Fri, 31 Jul 2026 06:20:00 -0600
Subject: [PATCH 12/12] Fallback for renameat2()/RENAME_EXCHANGE on bionic

renameat2(2) and the RENAME_EXCHANGE flag are Linux-only (glibc >= 2.28)
and are not provided by bionic (Android libc), which breaks the build of
rotating_file_logger.cpp on Termux with "use of undeclared identifier
'renameat2'". Guard the original call with
#if defined(__linux__) && !defined(__ANDROID__) and, on other platforms
(bionic included), emulate the atomic exchange of base_file_path <->
new_name with three renames via a temporary name. The emulation is not
atomic, but a writer that finds the log file missing already recreates
it in the inode check above.

diff --git a/libdnf5/logger/rotating_file_logger.cpp b/libdnf5/logger/rotating_file_logger.cpp
--- a/libdnf5/logger/rotating_file_logger.cpp
+++ b/libdnf5/logger/rotating_file_logger.cpp
@@ -189,6 +189,7 @@
 
                             // Rotate the last file by atomically swapping it with
                             // the prepared file.
+#if defined(__linux__) && !defined(__ANDROID__)
                             if (!renameat2(
                                     AT_FDCWD,
                                     base_file_path.string().c_str(),
@@ -200,6 +201,25 @@
                             } else {
                                 ::close(new_fd);
                             }
+#else
+                            // renameat2(2)/RENAME_EXCHANGE are Linux-only
+                            // (glibc); bionic (Android libc) does not provide
+                            // them. Emulate the exchange of base_file_path <->
+                            // new_name with three renames via a temporary name.
+                            // Not atomic, but a writer that finds the log file
+                            // missing already recreates it in the check above.
+                            auto swap_tmp = fmt::format(
+                                "{}.{}.swap", base_file_path.string(), ::getpid());
+                            auto base_str = base_file_path.string();
+                            if (::rename(base_str.c_str(), swap_tmp.c_str()) == 0 &&
+                                ::rename(new_name.c_str(), base_str.c_str()) == 0 &&
+                                ::rename(swap_tmp.c_str(), new_name.c_str()) == 0) {
+                                ::close(log_file_fd);
+                                log_file_fd = new_fd;
+                            } else {
+                                ::close(new_fd);
+                            }
+#endif
                         }
                     } catch (...) {
                     }
