From: dnf-for-termux <dev@termux.dev>
Date: Thu, 06 Aug 2026 00:00:00 -0600
Subject: [PATCH 1/1] Point bootc::is_writable() at TERMUX_PREFIX (non-FHS)

Termux is a non-FHS environment: the install prefix is
/data/data/com.termux/files/usr, not /usr. bootc::is_writable() must
really test the writability of the install location, so it statvfs()es
TERMUX_PREFIX instead of the hardcoded /usr. This keeps the abort-clean
behaviour if the real prefix is read-only. This file does not include
const.hpp, so TERMUX_PREFIX is defined here (guarded for non-Android
builds, where behaviour is identical to upstream).

diff --git a/libdnf5/utils/bootc.cpp b/libdnf5/utils/bootc.cpp
--- a/libdnf5/utils/bootc.cpp
+++ b/libdnf5/utils/bootc.cpp
@@ -33,6 +33,14 @@
 #include <memory>
 #include <string>
 
+#ifndef TERMUX_PREFIX
+#ifdef __ANDROID__
+#define TERMUX_PREFIX "/data/data/com.termux/files/usr"
+#else
+#define TERMUX_PREFIX "/usr"
+#endif
+#endif
+
 namespace libdnf5::utils::bootc {
 
 bool is_bootc_system() {
@@ -86,7 +94,7 @@
 bool is_writable() {
     struct statvfs vfs;
-    if (statvfs("/usr", &vfs) != 0) {
-        throw libdnf5::SystemError(errno, M_("Failed to stat /usr filesystem"));
+    if (statvfs(TERMUX_PREFIX, &vfs) != 0) {
+        throw libdnf5::SystemError(errno, M_("Failed to stat filesystem"));
     }
     return (vfs.f_flag & ST_RDONLY) == 0;
 }
