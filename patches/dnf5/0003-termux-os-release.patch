From: dnf-for-termux <dev@termux.dev>
Date: Wed, 29 Jul 2026 22:54:00 -0600
Subject: [PATCH 3/6] Adapt os_release.hpp default path for Termux ($PREFIX)

Wrap the default /etc/os-release path with PREFIX_PATH so it
resolves under Termux's $PREFIX. Also add the TERMUX_PREFIX and
PREFIX_PATH macros since this header does not include const.hpp.

diff --git a/include/libdnf5/utils/os_release.hpp b/include/libdnf5/utils/os_release.hpp
--- a/include/libdnf5/utils/os_release.hpp
+++ b/include/libdnf5/utils/os_release.hpp
@@ -27,6 +27,15 @@
 #include <string>
 #include <utility>

+#ifndef TERMUX_PREFIX
+#ifdef __ANDROID__
+#define TERMUX_PREFIX "/data/data/com.termux/files/usr"
+#else
+#define TERMUX_PREFIX ""
+#endif
+#endif
+#define PREFIX_PATH(path) TERMUX_PREFIX path
+
 namespace libdnf5::utils {

 /// Object which loads and exposes values from an os-release file.
@@ -35,7 +44,7 @@
     /// Creates an instance of `OSRelease` from the file at `path`.
     ///
     /// @param path The path to the os-release file to load and parse.
-    explicit OSRelease(std::filesystem::path path = "/etc/os-release") : path(std::move(path)) {}
+    explicit OSRelease(std::filesystem::path path = PREFIX_PATH("/etc/os-release")) : path(std::move(path)) {}

     /// Returns the corresponding os-release value for `key`.
     /// If the value for `key` isn't set, `default_value` is returned.
